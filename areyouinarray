#находит количество клеток в таблице умножения размера N × N, в которых записано число X.
#Он поочередно проверяет каждую строку таблицы (от 1 до N) и смотрит, может ли число X находиться в этой строке.
n, x = map(int, input().split())

count = 0
for i in range(1, n + 1):
  if x % i == 0 and x // i <= n:
    count += 1

print(count)
